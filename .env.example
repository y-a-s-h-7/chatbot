# ---------------------------------------------------------------------------
# Optional. The app works with no .env at all: the browser model needs no key,
# and you can paste your own provider keys in Settings.
# ---------------------------------------------------------------------------

# Server-side keys. They are ONLY read by the optional rate-limited free proxy
# (/api/chat). They are never sent to the browser and never logged.
# Leave both empty to keep the proxy disabled.
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Which upstream the free proxy uses: "openrouter" (default) or "gemini".
FREE_PROXY_PROVIDER=openrouter

# The single model the proxy is allowed to serve. The client cannot override it,
# so a leaked deployment cannot be used to burn your credits on a big model.
FREE_PROXY_MODEL=google/gemma-4-31b-it:free

# Optional allow-list if you want users to pick between a few cheap models.
# FREE_PROXY_ALLOWED_MODELS=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free

# Per-IP limits for the shared free tier.
FREE_PROXY_RPM=12
FREE_PROXY_RPD=200

# Public URL of the deployed proxy, e.g. https://my-app.vercel.app/api/chat
# Set this in production builds so the "Free - limited" model appears.
# Set it to "off" for a purely static deployment: the app then skips the
# free-tier check instead of logging a 404 for a function that is not there,
# and the free-tier model simply reports as unavailable.
VITE_FREE_PROXY_URL=
