# Build mode for the Android shell (`vite build --mode android`).
#
# The WebView serves the bundle from its own asset directory, so /api/chat does
# not exist here either. Same reasoning as .env.desktop.
#
# Optional: point this at a deployed free-tier endpoint to keep that model in the
# Android build, e.g. VITE_FREE_PROXY_URL=https://your-app.vercel.app/api/chat
VITE_FREE_PROXY_URL=off
