# Dependencies
node_modules/

# Build output
dist/
.vercel/

# TypeScript incremental cache
*.tsbuildinfo

# Environment files — keep the template, ignore the rest
.env
.env.*
!.env.example
# Build modes for the native shells. They carry no secrets (only which optional
# features are switched off), and the builds are not reproducible without them.
!.env.desktop
!.env.android

# Secrets: nothing key-shaped belongs in the repo.
*.keystore
*.jks
*.p12
*.pfx
keystore.properties

# Desktop packaging output (electron-builder)
release/
dist-electron/

# Android platform build output. The generated `android/` project IS committed
# (Capacitor expects it); only its build products and local machine config are not.
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
*.lnk

# Test / coverage output
coverage/

# Agent / AI tool folders — local tool state, not app code
.freebuff/
.cursor/
.claude/
.chatgpt/
