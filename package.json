{
  "name": "chatbot-llm",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A fast, beautiful chat app that talks to LLM providers directly from the browser, plus Electron (Windows) and Capacitor (Android) shells around the same build.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "mock": "node scripts/mock-provider.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "electron:dev": "node scripts/electron-dev.mjs",
    "build:desktop": "tsc -b && vite build --mode desktop",
    "build:win": "npm run build:desktop && electron-builder --win",
    "build:win:dir": "npm run build:desktop && electron-builder --win --dir",
    "build:android:web": "tsc -b && vite build --mode android",
    "cap:sync": "npm run build:android:web && cap sync android",
    "cap:open": "cap open android",
    "build:android": "node scripts/build-android.mjs",
    "android:patch": "node scripts/patch-android.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^7.1.6",
    "@capacitor/android": "^7.6.9",
    "@capacitor/app": "^7.1.2",
    "@capacitor/browser": "^7.0.5",
    "@capacitor/core": "^7.6.9",
    "@capacitor/keyboard": "^7.0.6",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "@mlc-ai/web-llm": "^0.2.79",
    "@tanstack/react-virtual": "^3.13.12",
    "highlight.js": "^11.11.1",
    "idb-keyval": "^6.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^5.0.3"
  }
}
