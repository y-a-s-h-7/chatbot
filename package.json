{
  "name": "chatbot-llm",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A fast, beautiful chat app that talks to LLM providers directly from the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "mock": "node scripts/mock-provider.mjs"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.79",
    "@tanstack/react-virtual": "^3.13.12",
    "highlight.js": "^11.11.1",
    "idb-keyval": "^6.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^5.0.3"
  }
}
